[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/education_manager.gd" id="1_edu"]

[node name="EducationCard" type="PanelContainer"]
theme_type_variation = &"SolidPanel"
anchors_preset = 7
anchor_left = 0.5
anchor_top = 1.0
anchor_right = 0.5
anchor_bottom = 1.0
offset_left = -300.0
offset_top = -300.0
offset_right = 300.0
offset_bottom = -92.0
grow_horizontal = 2
grow_vertical = 0
script = ExtResource("1_edu")

[node name="VBox" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Header" type="HBoxContainer" parent="VBox"]
layout_mode = 2

[node name="Tag" type="Label" parent="VBox/Header"]
layout_mode = 2
theme_override_colors/font_color = Color(0.3, 0.85, 0.82, 1)
theme_override_font_sizes/font_size = 14
text = "BİLGİ KARTI  "

[node name="EduTitle" type="Label" parent="VBox/Header"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 20

[node name="EduClose" type="Button" parent="VBox/Header"]
unique_name_in_owner = true
custom_minimum_size = Vector2(36, 32)
layout_mode = 2
tooltip_text = "Kapat"
text = "×"

[node name="EduSummary" type="RichTextLabel" parent="VBox"]
unique_name_in_owner = true
layout_mode = 2
bbcode_enabled = true
fit_content = true

[node name="EduMore" type="Button" parent="VBox"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 0
toggle_mode = true
text = "Ayrıntılı bilgi"

[node name="EduBody" type="RichTextLabel" parent="VBox"]
unique_name_in_owner = true
visible = false
layout_mode = 2
bbcode_enabled = true
fit_content = true

[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/settings_panel.gd" id="1_s"]

[node name="SettingsPanel" type="PanelContainer"]
theme_type_variation = &"SolidPanel"
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -240.0
offset_top = -130.0
offset_right = 240.0
offset_bottom = 130.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_s")

[node name="VBox" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Header" type="HBoxContainer" parent="VBox"]
layout_mode = 2

[node name="Title" type="Label" parent="VBox/Header"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 26
text = "Ayarlar"

[node name="CloseButton" type="Button" parent="VBox/Header"]
unique_name_in_owner = true
custom_minimum_size = Vector2(36, 32)
layout_mode = 2
tooltip_text = "Kapat (Esc)"
text = "×"

[node name="Fullscreen" type="CheckButton" parent="VBox"]
unique_name_in_owner = true
layout_mode = 2
text = "Tam ekran"

[node name="VSync" type="CheckButton" parent="VBox"]
unique_name_in_owner = true
layout_mode = 2
text = "Dikey senkron (V-Sync)"

[resource]
script = ExtResource("1_oo7yo")
id = &"carbon_footprint"
title = "Karbon ayak izi"
definition = "Bir kişinin, kurumun ya da etkinliğin havaya çıkardığı bütün ısıtan gazların toplamı."
example = "Toplu taşıma kullanmak, aynı yolculuğu tek başına arabayla yapmaktan genellikle daha küçük ayak izi bırakır."
game_link = "Ulaşım ve çöp yatırımları şehrinin karbon puanını düşürür."
sources = Array[String](["The Nature Conservancy, What is your carbon footprint? (web sayfası), https://www.nature.org/en-us/get-involved/how-to-help/carbon-footprint-calculator/, erişim 2026-10-31"])

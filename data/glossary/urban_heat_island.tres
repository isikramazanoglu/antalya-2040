id = &"urban_heat_island"
title = "Kentsel ısı adası"
definition = "Asfalt ve betonun ısıyı tutması nedeniyle şehirlerin çevrelerine göre daha sıcak olması."
example = "Ağaçlı bir parkın, çevresindeki asfalt caddeden daha serin olması."
game_link = "Yeşil park sıcak hava dalgası hasarını azaltır."
sources = Array[String](["US EPA, Heat Island Effect (web sayfası), https://www.epa.gov/heatislands, erişim 2026-10-31"])

[resource]
script = ExtResource("1_u65ef")
id = &"water_stress"
title = "Su stresi"
definition = "Bir yerde insanların ihtiyaç duyduğu tatlı suyun, eldeki sudan fazla olması."
example = "Yazın nüfus artarken barajların çekilmesi."
game_link = "\"Su ve elektrik\" sayfasında şehrin suyu ve ihtiyacı karşılaştırılır."
sources = Array[String](["FAO, Water scarcity (web sayfası), https://www.fao.org/land-water/water/water-scarcity/en/, erişim 2026-10-31"])

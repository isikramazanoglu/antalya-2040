[resource]
script = ExtResource("1_87j6y")
id = &"greenhouse_gases"
title = "Sera gazları"
definition = "Atmosferde ısıyı tutan gazlar. Karbondioksit, metan ve diazot monoksit başlıcalarıdır."
example = "Çöplükte çürüyen gıda atığı metan çıkarır."
game_link = "Yerel emisyon endeksi şehrin sera gazı salımını göreli olarak gösterir."
sources = Array[String](["US EPA, Overview of Greenhouse Gases (web sayfası), https://www.epa.gov/ghgemissions/overview-greenhouse-gases, erişim 2026-10-31"])

[gd_resource type="Resource" script_class="GlossaryTerm" format=3]

[ext_resource type="Script" path="res://scripts/data/glossary_term.gd" id="1_hyplm"]

[resource]
script = ExtResource("1_hyplm")
id = &"greenhouse_effect"
title = "Sera etkisi"
definition = "Havadaki bazı gazların, Dünya'dan uzaya kaçmak isteyen ısının bir kısmını tutarak Dünya'yı ısıtması. İnsanlar bu gazları artırdıkça etki de güçleniyor."
example = "Güneşte bırakılan kapalı arabanın içinin ısınmasına benzetilir."
game_link = "İklim Laboratuvarı'nın \"Dünyanın havası\" sayfasında anlatılır."
sources = Array[String](["NASA Science, Causes of climate change (web sayfası), https://science.nasa.gov/climate-change/causes/, erişim 2026-10-31"])

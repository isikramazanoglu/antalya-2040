[resource]
script = ExtResource("1_2w63x")
id = &"mitigation"
title = "İklim değişikliğini azaltım"
definition = "Isıtan gazları daha az çıkararak ya da havadan geri alarak iklim değişikliğini yavaşlatmak için yapılanlar."
example = "Fosil elektrik yerine güneş enerjisi kullanmak."
game_link = "Güneş, toplu taşıma, kompost gibi yatırımlar karbonu azaltır."
sources = Array[String](["NASA Science, Mitigation and Adaptation (web sayfası), https://science.nasa.gov/climate-change/adaptation-mitigation/, erişim 2026-10-31"])

[gd_resource type="Resource" script_class="InfoCard" format=3]

[ext_resource type="Script" path="res://scripts/data/info_card.gd" id="1_ahypq"]

[resource]
script = ExtResource("1_ahypq")
id = &"card_public_efficiency"
title = "Önce tasarruf"
body = "Harcanmayan enerji, üretilmesi gerekmeyen enerjidir. Verimli aydınlatma, yalıtım ve doğru ayarlanmış ısıtma-soğutma sistemleri kamu binalarının tüketimini düşürür."
benefit = "Okul, hastane ve belediye binalarının enerji tüketimini düşürür."
climate_link = "Harcanmayan elektriği üretmek gerekmez; böylece karbon da baştan azalır."
strategic = "Ucuz bir yatırımla hem elektriği hem de binalardan çıkan karbonu iyileştirir."
sources = Array[String](["IEA, Buildings: Energy consumption and efficiency (web sayfası), https://www.iea.org/energy-system/buildings, erişim 2026-10-31"])

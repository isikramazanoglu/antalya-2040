[gd_resource type="Resource" script_class="InfoCard" format=3]

[ext_resource type="Script" path="res://scripts/data/info_card.gd" id="1_tt54t"]

[resource]
script = ExtResource("1_tt54t")
id = &"card_coastal_restoration"
title = "Doğal kıyı savunması"
body = "Kumullar ve kıyı bitkileri dalgaların enerjisini emer ve kıyı erozyonunu yavaşlatır. Erken uyarı sistemi, taşkın gelmeden insanların ve araçların güvenli yere taşınmasına zaman kazandırır."
benefit = "Kumulları ve kıyı bitki örtüsünü onarır, erken uyarı sistemi kurar."
climate_link = "Yükselen deniz ve fırtınalara karşı doğal bir tampon oluşturur."
strategic = "Kıyı taşkınında zararı en çok azaltan yatırımdır; doğayı da güçlendirir."
sources = Array[String](["IPCC, Special Report on the Ocean and Cryosphere in a Changing Climate (SROCC), 2019, https://www.ipcc.ch/srocc/, erişim 2026-10-31"])

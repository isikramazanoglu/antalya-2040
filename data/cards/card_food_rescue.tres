[gd_resource type="Resource" script_class="InfoCard" format=3]

[ext_resource type="Script" path="res://scripts/data/info_card.gd" id="1_ywluu"]

[resource]
script = ExtResource("1_ywluu")
id = &"card_food_rescue"
title = "Gıda israfı"
body = "Çöpe giden gıda, onu üretmek için harcanan su ve enerjinin de boşa gitmesi demektir. Çöplükte çürüyen gıda ayrıca güçlü bir sera gazı olan metan üretir."
benefit = "Yenilebilir ama satılmayan gıdayı ihtiyacı olanlara ulaştırır."
climate_link = "Çöpe giden gıdanın çürürken ürettiği metanı azaltır."
strategic = "En ucuz yatırımlardan biri; yaşam kalitesini artırır ve çöpten çıkan karbonu azaltır."
sources = Array[String](["US EPA, Composting / Reducing the impact of wasted food (web sayfası), https://www.epa.gov/sustainable-management-food/reducing-impact-wasted-food-feeding-soil-and-composting, erişim 2026-10-31"])

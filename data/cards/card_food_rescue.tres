[gd_resource type="Resource" script_class="InfoCard" format=3]

[ext_resource type="Script" path="res://scripts/data/info_card.gd" id="1_ywluu"]

[resource]
script = ExtResource("1_ywluu")
id = &"card_food_rescue"
title = "Gıda israfı"
body = "Çöpe giden gıda, onu üretmek için harcanan su ve enerjinin de boşa gitmesi demektir. Çöplükte çürüyen gıda ayrıca güçlü bir sera gazı olan metan üretir."

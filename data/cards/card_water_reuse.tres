[gd_resource type="Resource" script_class="InfoCard" format=3]

[ext_resource type="Script" path="res://scripts/data/info_card.gd" id="1_3gpck"]

[resource]
script = ExtResource("1_3gpck")
id = &"card_water_reuse"
title = "Suyu iki kez kullanmak"
body = "Evlerden gelen atık su arıtıldıktan sonra içme suyu gerektirmeyen işlerde, örneğin park sulamasında kullanılabilir. Böylece barajlardan ve yer altından çekilen su azalır."
benefit = "Arıtılmış suyu sulama ve sanayide yeniden kullanır."
climate_link = "Barajlardan ve yeraltından çekilen suyu azaltarak kuraklığa dayanıklılığı artırır."
strategic = "Su arzını büyütür, kuraklık hasarını azaltır ve kıyı arsalarına da kurulabilir."
sources = Array[String](["US EPA, Water Reuse and Recycling (web sayfası), https://www.epa.gov/waterreuse, erişim 2026-10-31"])

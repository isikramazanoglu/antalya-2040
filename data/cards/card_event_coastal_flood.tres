[resource]
script = ExtResource("1_0hovq")
id = &"card_event_coastal_flood"
title = "Deniz seviyesi ve fırtınalar"
body = "Okyanuslar ısındıkça genleşir ve buzullar eridikçe deniz seviyesi yükselir. Daha yüksek bir deniz seviyesinde aynı fırtına kıyıda daha büyük taşkınlara yol açar."

[gd_resource type="Resource" script_class="InfoCard" format=3]

[ext_resource type="Script" path="res://scripts/data/info_card.gd" id="1_vndcc"]

[resource]
script = ExtResource("1_vndcc")
id = &"card_recycling_compost"
title = "Kompost"
body = "Organik atık havasız bir çöplükte çürürse metan çıkar. Kompost tesisinde havayla temas ederek ayrışır ve bahçelerde kullanılabilecek verimli bir toprağa dönüşür."
benefit = "Ambalajı geri kazanır, organik atığı toprağa döndürür."
climate_link = "Çöplükte çürüyen organik atığın metan üretmesini önler."
strategic = "Çöpten çıkan karbonu en çok azaltan yatırımdır."
sources = Array[String](["US EPA, Composting / Reducing the impact of wasted food (web sayfası), https://www.epa.gov/sustainable-management-food/reducing-impact-wasted-food-feeding-soil-and-composting, erişim 2026-10-31"])

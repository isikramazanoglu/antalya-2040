[ext_resource type="Script" path="res://scripts/data/info_card.gd" id="1_rjgqg"]

[resource]
script = ExtResource("1_rjgqg")
id = &"card_efficient_housing"
title = "Isı yalıtımı"
body = "İyi yalıtılmış bir bina yazın içeriyi serin, kışın sıcak tutar. Klima ve ısıtma daha az çalışır, böylece hem enerji faturası hem de binalardan kaynaklanan emisyon azalır."
benefit = "Şehre yeni ve konforlu konut alanı kazandırır."
climate_link = "Yalıtımlı binalar ısıtma ve soğutma için daha az enerji harcar."
strategic = "Şehir büyürken binalardan çıkan karbonu az tutar; sıcak günlerde evlerin içi daha serin kalır."
sources = Array[String](["IEA, Buildings: Energy consumption and efficiency (web sayfası), https://www.iea.org/energy-system/buildings, erişim 2026-10-31"])

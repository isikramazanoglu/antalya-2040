[resource]
script = ExtResource("1_ln6o5")
id = &"card_event_heatwave"
title = "Sıcak hava dalgaları"
body = "Bilim insanları, iklim ısındıkça aşırı sıcak günlerin daha sık ve daha şiddetli yaşanacağını öngörüyor. Akdeniz havzası bu değişimden en çok etkilenen bölgeler arasında sayılıyor."

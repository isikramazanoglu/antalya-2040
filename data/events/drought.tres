earliest_year = 2044
scripted_year = 2046
base_damage = {
"credits": -150,
"ecosystem_health": -5.0,
"water_security": -20.0
}
responses = Array[ExtResource("2_6hgnv")]([SubResource("Resource_pt2ig"), SubResource("Resource_6hgnv"), SubResource("Resource_m6xv3"), SubResource("Resource_j4il8"), SubResource("Resource_1htna")])
warning_text = "Kuraklık riski yükseliyor. Şehrinizin su rezervlerini ve tüketim seviyesini kontrol edin."

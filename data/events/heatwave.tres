risk_type = &"heat"
earliest_year = 2042
scripted_year = 2043
base_damage = {
"credits": -100,
"energy_security": -8.0,
"population": -10,
"quality_of_life": -10.0
}
responses = Array[ExtResource("2_b6ikl")]([SubResource("Resource_0fyod"), SubResource("Resource_b6ikl"), SubResource("Resource_xj6rt"), SubResource("Resource_2ueqx"), SubResource("Resource_v1lmy"), SubResource("Resource_27xy8")])
warning_text = "Çok sıcak günler geliyor. İnsanlar sıcaktan etkilenecek, klimalar daha çok elektrik harcayacak."
vulnerability_stats = {
"ecosystem_health": 0.5,
"quality_of_life": 0.5
}
visual_effect_id = &"heat_haze"
affected_area = &"city"
affected_plot_kinds = Array[StringName]([&"urban"])
info_card = ExtResource("1_0fyod")
